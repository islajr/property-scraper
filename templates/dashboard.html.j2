<main id="main-content">
  <section class="dashboard-intro" aria-labelledby="main-title">
    <div>
      <p class="eyebrow breadcrumb"><a href="https://akinmokun.com/projects/">Systems</a><span aria-hidden="true">/</span> PS-0 · Property data</p>
      <h1 id="main-title">PropertyScraper</h1>
      <p class="intro-copy">A view into Nigeria’s property listings.<br>Discovery, listing activity, and the pipeline behind the data.</p>
      <div class="intro-links"><a href="https://github.com/islajr/property-scraper" target="_blank" rel="noopener noreferrer">View source ↗</a><a href="https://reports.akinmokun.com/">Market reports ↗</a></div>
    </div>
    <aside class="snapshot" aria-label="Dashboard snapshot">
      <span class="eyebrow">Pipeline status</span>
      <div class="status {{ telemetry.system_status_class | default('unknown') }}"><span class="status-dot" aria-hidden="true"></span>{{ telemetry.system_status | default('UNKNOWN') | replace('_', ' ') | lower | capitalize }}</div>
      <dl><div><dt>Last compiled</dt><dd>{{ telemetry.last_updated }}</dd></div><div><dt>Refresh</dt><dd>After scheduled runs</dd></div></dl>
    </aside>
  </section>

  <nav class="dashboard-nav" aria-label="Dashboard sections"><a href="#overview">Overview</a><a href="#run-telemetry">Recent runs</a><a href="#portals">Sources</a><a href="#pipeline">About the pipeline</a><span>Public telemetry</span></nav>

  <section id="overview" class="dashboard-section" aria-labelledby="overview-title">
    <div class="section-heading"><h2 id="overview-title">The dataset at a glance</h2><span class="section-note">Cumulative coverage</span></div>
    <div class="metrics-grid">
      <article class="metric-card" id="card-total-ingested"><h3 class="metric-label">Total listings</h3><p class="metric-value">{{ "{:,}".format(telemetry.total_ingested) }}</p><p class="metric-sub">Records collected across source portals</p></article>
      <article class="metric-card" id="card-active-listings"><h3 class="metric-label">Active listings</h3><p class="metric-value">{{ "{:,}".format(telemetry.active_listings) }}</p><p class="metric-sub">Currently marked active in the dataset</p></article>
      <article class="metric-card" id="card-spatial-coverage"><h3 class="metric-label">Neighbourhoods</h3><p class="metric-value">{{ "{:,}".format(telemetry.neighbourhoods_count) }}</p><p class="metric-sub">Across {{ telemetry.cities_count }} cities</p></article>
      <article class="metric-card"><h3 class="metric-label">Source portals</h3><p class="metric-value">{{ "%02d" | format(telemetry.portals | length) }}</p><p class="metric-sub">Property listing platforms</p></article>
    </div>
  </section>

  <section class="dashboard-section" id="run-telemetry" aria-labelledby="runs-title">
    <div class="section-heading"><h2 id="runs-title">Recent runs</h2><span class="section-note">Latest execution by mode</span></div>
    <div class="runs-grid">
      {% for key, title, cadence, description, fields in [
        ('discovery_run', 'Discovery', 'Weekly', 'Finds new listings and updates the dataset.', [('total_scraped', 'Dataset records'), ('new_listings', 'New listings'), ('updated_listings', 'Updated'), ('errors', 'Errors')]),
        ('health_check_run', 'Health check', 'Daily', 'Revisits listing URLs to check activity and prices.', [('checked', 'Checked'), ('active_confirmed', 'Active'), ('removed', 'Removed'), ('price_changes', 'Price changes')])
      ] %}
      {% set run = telemetry[key] %}
      <article class="run-card" id="card-{{ key | replace('_', '-') }}">
        <div class="run-heading"><span class="eyebrow">{{ cadence }} / {{ '%02d' | format(loop.index) }}</span><span class="run-status {{ run.status | lower }}">{{ run.status | replace('_', ' ') | lower | capitalize }}</span></div>
        <h3>{{ title }}</h3><p class="run-description">{{ description }}</p>
        <dl class="run-stats">{% for field, label in fields %}<div><dt>{{ label }}</dt><dd>{{ "{:,}".format(run[field]) }}</dd></div>{% endfor %}</dl>
        <div class="run-footer"><span>{{ run.timestamp }}</span><span>{{ run.duration }}</span></div>
      </article>
      {% endfor %}
    </div>
  </section>

  <section class="dashboard-section" id="portals" aria-labelledby="portals-title">
    <div class="section-heading"><h2 id="portals-title">Source coverage</h2><span class="section-note">{{ telemetry.portals | length }} portals · scheduled discovery</span></div>
    <div class="table-wrapper" role="region" aria-label="Source portal listing counts" tabindex="0">
      <table class="health-table" id="portal-health-table">
        <caption class="sr-only">Listing counts and share of the dataset by source portal</caption>
        <thead><tr><th scope="col">Source portal</th><th scope="col" class="numeric">Listings</th><th scope="col">Share of source records</th><th scope="col">Extraction</th></tr></thead>
        <tbody>
        {% set source_total = telemetry.portals | sum(attribute='last_harvest_count') %}
        {% for portal in telemetry.portals %}
        {% set share = (portal.last_harvest_count / source_total * 100) if source_total else 0 %}
        <tr><th scope="row"><span class="portal-index">{{ '%02d' | format(loop.index) }}</span>{{ portal.name }}</th><td class="numeric">{{ "{:,}".format(portal.last_harvest_count) }}</td><td><div class="share-cell"><span class="share-track" aria-hidden="true"><span style="width: {{ '%.2f' | format(share) }}%"></span></span><span>{{ '%.1f' | format(share) }}%</span></div></td><td class="extractor">{{ portal.extractor_type }}</td></tr>
        {% else %}<tr><td colspan="4">No source data available.</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
    <p class="data-note">Counts describe records in the dataset, rather than requests made during the latest run.</p>
  </section>

  <section class="pipeline-section" id="pipeline" aria-labelledby="pipeline-title">
    <div><p class="eyebrow">Behind the numbers</p><h2 id="pipeline-title">From listing to history.</h2><p>PS-0 collects public property listings, standardises their details, and maps neighbourhoods. Subsequent checks track price changes and confirm when listings are removed.</p><a class="text-link" href="https://github.com/islajr/property-scraper#readme" target="_blank" rel="noopener noreferrer">Read the documentation ↗</a></div>
    <div class="pipeline-detail"><ol class="pipeline-flow" aria-label="Discovery pipeline"><li>Collect</li><li>Normalise</li><li>Geocode</li><li>Store</li></ol><p>A listing disappearing from a search feed does not confirm removal. Health checks revisit the original URL before changing its status.</p><p class="data-note">This dashboard is a snapshot compiled after runs, not a live stream.</p></div>
  </section>
</main>
