      </ul>
    </div>
  </header>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
    <nav class="mobile-drawer-nav">
      <a href="https://akinmokun.com/" class="mobile-drawer-link"><span>Home</span> <span>→</span></a>
      <a href="https://akinmokun.com/about" class="mobile-drawer-link"><span>About</span> <span>→</span></a>
      <a href="https://akinmokun.com/now" class="mobile-drawer-link"><span>Now</span> <span>→</span></a>
      <a href="https://akinmokun.com/blog/" target="_blank" class="mobile-drawer-link"><span>Blog</span> <span>↗</span></a>
      <a href="https://reports.akinmokun.com/" target="_blank" class="mobile-drawer-link"><span>Reports</span> <span>↗</span></a>
      <a href="https://ps0.akinmokun.com" class="mobile-drawer-link" style="color: var(--gold-light);"><span>PS-0 Telemetry</span> <span>✦</span></a>
      <a href="https://akinmokun.com/credentials" class="mobile-drawer-link"><span>Credentials</span> <span>→</span></a>

      <div class="mobile-drawer-footer">
        akinmokun.com • Sovereign Polymath Protocol
      </div>
    </nav>
  </div>

  <main>
    <!-- Hero Section -->
    <section class="hero" id="overview">
      <div class="container">
        <!-- Top Action Bar: GitHub Repo + Status Pill + Quick Links -->
        <div class="hero-center-bar">
          <a href="https://github.com/islajr/property-scraper" target="_blank" rel="noopener noreferrer" class="repo-badge-link" id="hero-github-link">
            <span>[ gh: islajr/property-scraper ↗ ]</span>
          </a>

          <div class="status-badge {{ telemetry.system_status_class | default('operational') }}" id="status-indicator">
            <span class="status-dot"></span>
            <span>{{ telemetry.system_status | default('OPERATIONAL') }}</span>
          </div>

          <div class="hero-quicklinks">
            <a href="#overview">[ Overview ]</a>
            <a href="#run-telemetry">[ Run Logs ]</a>
            <a href="#portals">[ Portal Matrix ]</a>
            <a href="#hygiene">[ Data Hygiene ]</a>
          </div>
        </div>

        <h1 class="hero-title" id="main-title">PS-0 PropertyScraper</h1>
        <p class="hero-subtitle">
          Autonomous multi-portal data engineering pipeline harvesting, normalizing, geocoding, and deduplicating Nigerian real estate listing telemetry in real-time.
        </p>
      </div>
    </section>

    <!-- Pipeline Execution Telemetry: Both Discovery Run & Health Check Run -->
    <section class="run-section" id="run-telemetry">
      <div class="container">
        <div class="section-label">Pipeline Execution Logs</div>
        <h2 class="section-title">Latest Run Telemetry by Mode</h2>

        <div class="runs-grid">
          <!-- 1. Discovery Run Card -->
          <div class="run-card discovery" id="card-discovery-run">
            <div class="run-header">
              <div class="run-title-group">
                <span class="run-mode-tag">DISCOVERY RUN</span>
                <span class="run-status-badge {{ telemetry.discovery_run.status | lower }}">{{ telemetry.discovery_run.status }}</span>
              </div>
              <div class="run-timestamp"><strong class="mono-cell gold">{{ telemetry.discovery_run.timestamp }}</strong></div>
            </div>

            <div class="run-stats-grid">
              <div class="run-stat-item">
                <div class="run-stat-label">Total Ingested</div>
                <div class="run-stat-val gold">{{ "{:,}".format(telemetry.discovery_run.total_scraped) }}</div>
              </div>
              <div class="run-stat-item">
                <div class="run-stat-label">New Discovered</div>
                <div class="run-stat-val green">+{{ "{:,}".format(telemetry.discovery_run.new_listings) }}</div>
              </div>
              <div class="run-stat-item">
                <div class="run-stat-label">Updated</div>
                <div class="run-stat-val">{{ "{:,}".format(telemetry.discovery_run.updated_listings) }}</div>
              </div>
              <div class="run-stat-item">
                <div class="run-stat-label">Duration</div>
                <div class="run-stat-val">{{ telemetry.discovery_run.duration }}</div>
              </div>
            </div>
          </div>

          <!-- 2. Health Check Run Card -->
          <div class="run-card health-check" id="card-health-check-run">
            <div class="run-header">
              <div class="run-title-group">
                <span class="run-mode-tag" style="background: rgba(74, 222, 128, 0.08); border-color: rgba(74, 222, 128, 0.3); color: var(--live);">HEALTH CHECK RUN</span>
                <span class="run-status-badge {{ telemetry.health_check_run.status | lower }}">{{ telemetry.health_check_run.status }}</span>
              </div>
              <div class="run-timestamp"><strong class="mono-cell gold">{{ telemetry.health_check_run.timestamp }}</strong></div>
            </div>

            <div class="run-stats-grid">
              <div class="run-stat-item">
                <div class="run-stat-label">Checked</div>
                <div class="run-stat-val">{{ "{:,}".format(telemetry.health_check_run.checked) }}</div>
              </div>
              <div class="run-stat-item">
                <div class="run-stat-label">Active Verified</div>
                <div class="run-stat-val green">{{ "{:,}".format(telemetry.health_check_run.active_confirmed) }}</div>
              </div>
              <div class="run-stat-item">
                <div class="run-stat-label">Removed</div>
                <div class="run-stat-val amber">{{ "{:,}".format(telemetry.health_check_run.removed) }}</div>
              </div>
              <div class="run-stat-item">
                <div class="run-stat-label">Price Changes</div>
                <div class="run-stat-val gold">{{ "{:,}".format(telemetry.health_check_run.price_changes) }}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Big Monospace Telemetry Counters -->
    <section class="metrics-section">
      <div class="container">
        <div class="section-label">Real-Time Ingestion</div>
        <h2 class="section-title">Pipeline Volumes & Coverage</h2>
        
        <div class="metrics-grid">
          <div class="metric-card" id="card-total-ingested">
            <div class="sparkline-header">
              <div class="metric-label">Total Records Ingested</div>
              {{ telemetry.sparkline_ingested | safe }}
            </div>
            <div class="metric-value">{{ "{:,}".format(telemetry.total_ingested) }}</div>
            <div class="metric-sub">Multi-portal cumulative scraped raw listings</div>
          </div>

          <div class="metric-card" id="card-active-listings">
            <div class="sparkline-header">
              <div class="metric-label">Active Unique Listings</div>
              {{ telemetry.sparkline_active | safe }}
            </div>
            <div class="metric-value">{{ "{:,}".format(telemetry.active_listings) }}</div>
            <div class="metric-sub">Verified active & deduplicated property listings</div>
          </div>

          <div class="metric-card" id="card-spatial-coverage">
            <div class="metric-label">Spatial Coverage</div>
            <div class="metric-value">{{ telemetry.cities_count }} <span style="font-size: 1.5rem; color: var(--text-dim);">Cities</span></div>
            <div class="metric-sub">{{ telemetry.neighbourhoods_count }} distinct geocoded neighbourhoods</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Source Portal Health Matrix -->
    <section class="matrix-section" id="portals">
      <div class="container">
        <div class="section-label">Source System Telemetry</div>
        <h2 class="section-title">Portal Ingestion Health Matrix</h2>

        <div class="table-wrapper">
          <table class="health-table" id="portal-health-table">
            <thead>
              <tr>
                <th>Portal Target</th>
                <th>Harvest Status</th>
                <th>Listing Count</th>
                <th>HTTP Success %</th>
                <th>Avg Latency</th>
                <th>Extractor Type</th>
              </tr>
            </thead>
            <tbody>
              {% for portal in telemetry.portals %}
              <tr>
                <td class="portal-name">
                  <span class="portal-indicator"></span>
                  {{ portal.name }}
                </td>
                <td><span class="rate-badge">{{ portal.status }}</span></td>
                <td class="mono-cell gold">{{ "{:,}".format(portal.last_harvest_count) }}</td>
                <td class="mono-cell">{{ portal.http_success_rate }}%</td>
                <td class="mono-cell">{{ portal.avg_latency_ms }} ms</td>
                <td class="mono-cell">{{ portal.extractor_type }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Deduplication & Data Hygiene Guardrails -->
    <section class="guardrails-section" id="hygiene">
      <div class="container">
        <div class="section-label">Pipeline Resilience</div>
        <h2 class="section-title">Data Hygiene & Quality Guardrails</h2>

        <div class="guardrails-grid">
          <div class="guardrail-card" id="card-dedup">
            <h3 class="guardrail-title">
              <span class="guardrail-icon">✦</span> Cross-Portal Deduplication
            </h3>
            <p class="guardrail-desc">
              Multi-tiered hashing on normalized title, neighbourhood, price cohort, and spatial coordinates. Merges cross-posted listings with <strong style="color: var(--gold-light);">{{ telemetry.dedup_rate }}% duplicate merge rate</strong> across targets.
            </p>
          </div>

          <div class="guardrail-card" id="card-anomalies">
            <h3 class="guardrail-title">
              <span class="guardrail-icon">✦</span> Outlier & Anomaly Detection
            </h3>
            <p class="guardrail-desc">
              Automatic Z-score price filtering isolates extreme input errors (e.g. typos, zero-price listings). Filtered <strong style="color: var(--gold-light);">{{ telemetry.anomalies_filtered }} price anomalies</strong> this month.
            </p>
          </div>

          <div class="guardrail-card" id="card-cooldown">
            <h3 class="guardrail-title">
              <span class="guardrail-icon">✦</span> Adaptive Health Check Cooldown
            </h3>
            <p class="guardrail-desc">
              Listing health check frequencies scale dynamically with listing age (2-day, 7-day, and 14-day intervals) driven by partial B-tree index queues and Overdue Ratio prioritization.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

